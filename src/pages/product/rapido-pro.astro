---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Rapido Pro — KG Robotics';
const description =
  'Rapido Pro Full HD push-camera system for sewer inspection from 40 mm to 300 mm — 60 m reel, KG41 camera with automatic up-right sensor position and portable control unit.';

const systemGallery = [
  { src: '/images/rapido-pro.png', alt: 'Rapido Pro — complete push-camera system, front three-quarter view' },
  { src: '/images/rapido-pro-system-01.png', alt: 'Rapido Pro — reel cart, control unit and camera head' },
  { src: '/images/rapido-pro-system-02.png', alt: 'Rapido Pro — side view with battery pack, keyboard and camera head' },
  { src: '/images/hero-overlay-rapido.png', alt: 'Rapido Pro — wheeled reel with monitor open and push rod' },
  { src: '/images/rapido-pro-system-04.png', alt: 'Rapido Pro — rear view with the monitor closed and camera head extended' },
  { src: '/images/rapido-pro-system-03.png', alt: 'Rapido Pro — 10.1 inch touchscreen and keyboard' },
];

const infographics = [
  { src: '/images/rapido-pro-system-01.png', alt: 'Rapido Pro — push camera reel, control unit and camera head' },
  { src: '/images/rapido-pro-system-02.png', alt: 'Rapido Pro — complete mobile push inspection system' },
  { src: '/images/rapido-pro-system-03.png', alt: 'Rapido Pro — control case, screen and keyboard' },
  { src: '/images/rapido-pro-system-04.png', alt: 'Rapido Pro — wheeled reel cart with the monitor closed' },
];

const kg60Head = [
  { src: '/images/kg60/01c.jpg', alt: 'KG60 camera head with spring neck, LED window and locating probe' },
  { src: '/images/kg60/01b.jpg', alt: 'KG60 camera head, close view of the LED ring around the lens' },
  { src: '/images/kg60/01a.jpg', alt: 'KG60 camera head, three-quarter view with the lens lit' },
  { src: '/images/kg60/02.jpg', alt: 'Rear of the KG60 camera head, showing the connector and spring neck' },
];

const kg60Skids = [
  { src: '/images/kg60/skid-01c.jpg', alt: 'KG60 camera head fitted with a centering skid' },
  { src: '/images/kg60/skid-01b.jpg', alt: 'KG60 with centering skid, side view of the head' },
  { src: '/images/kg60/skid-01a.jpg', alt: 'KG60 with centering skid, three-quarter view' },
  { src: '/images/kg60/skid-03.jpg', alt: 'KG60 with centering skid, viewed from the probe side' },
  { src: '/images/kg60/skid-02.jpg', alt: 'Rear of the KG60 with centering skid and connector' },
];

const fieldPhotos = [
  { src: '/images/rapido/07-screen.jpg', alt: 'Control screen showing the pipe interior during a push inspection', portrait: false },
  { src: '/images/rapido/06-camera-head.jpg', alt: 'KG41 camera head resting on the red push-rod reel', portrait: false },
  { src: '/images/rapido/09-feeding.jpg', alt: 'Operator holding the camera head at the manhole, reel cart behind', portrait: false },
  { src: '/images/rapido/10-operator.jpg', alt: 'Operator feeding the red push rod from the reel into the manhole', portrait: false },
  { src: '/images/rapido/11-watching.jpg', alt: 'Operator watching the inspection on the Rapido Pro screen', portrait: false },
  { src: '/images/rapido/12-skid.jpg', alt: 'Operator fitting a centering skid on the camera head', portrait: false },
];
---

<BaseLayout title={title} description={description} activeFam="push">
  <section class="block">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="sep">/</span><span>Rapido Pro</span>
      </div>
      <div class="pd-grid">
        <div class="pd-img pd-img--carousel">
          <div class="pd-carousel" data-interval="2600">
            {
              systemGallery.map((item, index) => (
                <img
                  class:list={['pd-carousel-slide', { active: index === 0 }]}
                  src={item.src}
                  alt={item.alt}
                  width="1024"
                  height="1024"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
          </div>
        </div>
        <div class="pd-info">
          <span class="eyebrow muted">Push camera system</span>
          <h1>Rapido Pro</h1>
          <div class="ptag">Push camera system · Full HD</div>
          <p class="desc">
            Rapido Pro Full HD is a push-mode video inspection system for pipelines from approximately <strong>40 mm to 300 mm</strong> — laterals, house
            connections and small mains. A portable control unit, 60&nbsp;m reel and KG41 camera head with automatic up-right sensor position deliver 1080p imaging,
            on-screen documentation and straightforward field handling from a compact, wheeled platform.
          </p>
          <div class="pd-specs">
            <div class="row">
              <span class="k">Inspecting range</span><span class="v">DN40–DN300 mm (1½″–12″)</span>
            </div>
            <div class="row">
              <span class="k">Camera head</span><span class="v">KG41, 1080p Full HD, automatic up-right sensor position</span>
            </div>
            <div class="row">
              <span class="k">Optics &amp; lighting</span><span class="v">105° horizontal FOV, 4-LED focused ring</span>
            </div>
            <div class="row">
              <span class="k">Push rod &amp; reel</span><span class="v">60 m, 512 Hz sonde, metre counter</span>
            </div>
            <div class="row">
              <span class="k">Control unit</span><span class="v">10.1″ 1080p touchscreen, keyboard shortcuts, USB or internal storage</span>
            </div>
            <div class="row">
              <span class="k">Power</span><span class="v">Milwaukee battery pack or mains adapter</span>
            </div>
            <div class="row">
              <span class="k">Pipe bends</span><span class="v">From DN75 at 90° (with centering skids)</span>
            </div>
            <div class="row">
              <span class="k">WEIGHT</span><span class="v">Lighter than you expect</span>
            </div>
          </div>
          <div class="pd-actions">
            <a href="/contact" class="btn btn-accent">
              Request information <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="/distributors" class="btn btn-dark">Find a distributor</a>
          </div>
        </div>
      </div>

      <div class="pc-wheels">
        <div class="pc-wheels-head">
          <span class="eyebrow muted">System</span>
          <h2>Push inspection, one platform</h2>
          <p class="pc-wheels-lead">Rapido Pro Full HD</p>
          <p>
            The reel cart, control console and camera head are designed to work as a single field system: feed the red push rod, track distance on the counter,
            capture video and stills with date, time and project overlays, and export from USB or internal memory. Centreing skids for DN75 and DN150 keep the
            KG41 head aligned in typical lateral sizes; the stainless camera body and steel reel frame are built for daily contractor use.
          </p>
        </div>
        <div class="pc-wheels-gallery pc-wheels-gallery--4">
          {
            infographics.map((item) => (
              <figure>
                <img src={item.src} alt={item.alt} loading="lazy" width="1024" height="1024" />
              </figure>
            ))
          }
        </div>
        <div class="field-gallery">
          {
            fieldPhotos.map((item) => (
              <figure>
                <img class:list={{ 'is-portrait': item.portrait }} src={item.src} alt={item.alt} width="1024" height="768" loading="lazy" />
              </figure>
            ))
          }
        </div>
      </div>

    </div>
  </section>

  <section class="block" id="camera">
    <div class="wrap camera-stack">
      <div class="camera-feature">
        <figure class="camera-feature-visual">
          <img src="/images/rapido-kg41-camera.jpg" alt="KG41 camera head with a focused LED ring around the lens" width="1024" height="1024" />
        </figure>
        <div class="camera-feature-copy">
          <span class="eyebrow muted">Camera head</span>
          <h2>KG41 Full HD</h2>
          <p>The picture comes from the KG41, a stainless head on the end of the rod. It records 1080p. Automatic up-right sensor position keeps the image upright as the head rolls through the pipe. A 105° horizontal view and a focused 4-LED ring light the wall ahead, from 40 mm laterals to 300 mm mains.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">Image</span><span class="v">1080p Full HD</span></div>
            <div class="row"><span class="k">Sensor position</span><span class="v">Automatic up-right</span></div>
            <div class="row"><span class="k">Optics</span><span class="v">105° horizontal field of view</span></div>
            <div class="row"><span class="k">Lighting</span><span class="v">4-LED focused ring</span></div>
            <div class="row"><span class="k">Body</span><span class="v">Stainless steel</span></div>
            <div class="row"><span class="k">In the pipe</span><span class="v">DN40–DN300, skids for DN75 and DN150</span></div>
          </div>
        </div>
      </div>
      <div class="camera-feature camera-feature--bend">
        <div class="camera-feature-copy">
          <span class="eyebrow muted">90° bends</span>
          <h2>Through the elbow</h2>
          <p>A sprung neck sits between the head and the rod. It flexes as the KG41 enters a bend, so the camera follows the pipe instead of stopping at the corner. From DN75, centering skids hold the head on axis through a 90° elbow and the survey continues past it.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">Bends</span><span class="v">90° from DN75</span></div>
            <div class="row"><span class="k">Skids</span><span class="v">DN75 and DN150</span></div>
            <div class="row"><span class="k">Neck</span><span class="v">Sprung, between head and rod</span></div>
          </div>
        </div>
        <figure class="camera-feature-visual">
          <img src="/images/rapido-kg41-spring.jpg" alt="Sprung neck of the KG41 camera head, built to flex through a bend" width="1024" height="1024" />
        </figure>
      </div>
    </div>
  </section>

  <section class="block home-stack" id="kg60">
    <div class="wrap camera-stack">
      <div class="camera-feature">
        <figure class="camera-feature-visual">
          <div class="pd-carousel" data-interval="4000">
            {
              kg60Head.map((item, index) => (
                <img
                  class:list={['pd-carousel-slide', { active: index === 0 }]}
                  src={item.src}
                  alt={item.alt}
                  width="1024"
                  height="1024"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
          </div>
        </figure>
        <div class="camera-feature-copy">
          <span class="eyebrow muted">Pan Tilt head</span>
          <h2>KG60</h2>
          <p>The KG60 is a pan and tilt head on the end of the rod. Pan and rotation sit in the head, so the operator looks around the wall, into a joint and into a connecting lateral, not only straight along the pipe. In the axial view the picture stays upright. It records 1080p. A focused 4-LED ring lights the wall, from 40 mm laterals to 300 mm mains.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">Head</span><span class="v">Pan and tilt</span></div>
            <div class="row"><span class="k">Image</span><span class="v">1080p Full HD</span></div>
            <div class="row"><span class="k">Axial view</span><span class="v">Picture stays upright</span></div>
            <div class="row"><span class="k">Optics</span><span class="v">105° horizontal field of view</span></div>
            <div class="row"><span class="k">Lighting</span><span class="v">4-LED focused ring</span></div>
            <div class="row"><span class="k">In the pipe</span><span class="v">DN40–DN300</span></div>
          </div>
        </div>
      </div>
      <div class="camera-feature camera-feature--bend">
        <div class="camera-feature-copy">
          <span class="eyebrow muted">Laterals</span>
          <h2>Into the connection</h2>
          <p>A sprung neck sits between the pan tilt head and the rod. It flexes as the KG60 enters a bend, so the camera follows the pipe instead of stopping at the corner. From DN75, centering skids hold the head on axis through a 90° elbow. Pan and tilt then look along the branch and back at the joint, and the survey continues into the connecting pipe.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">Bends</span><span class="v">90° from DN75</span></div>
            <div class="row"><span class="k">Look</span><span class="v">Along the lateral and back at the joint</span></div>
            <div class="row"><span class="k">Neck</span><span class="v">Sprung, between head and rod</span></div>
          </div>
        </div>
        <figure class="camera-feature-visual">
          <img src="/images/kg60/03.jpg" alt="Sprung neck of the KG60 camera head, built to flex through a bend" width="1024" height="1024" />
        </figure>
      </div>
      <div class="camera-feature">
        <figure class="camera-feature-visual">
          <div class="pd-carousel" data-interval="4000">
            {
              kg60Skids.map((item, index) => (
                <img
                  class:list={['pd-carousel-slide', { active: index === 0 }]}
                  src={item.src}
                  alt={item.alt}
                  width="1024"
                  height="1024"
                  loading="lazy"
                />
              ))
            }
          </div>
        </figure>
        <div class="camera-feature-copy">
          <span class="eyebrow muted">Centering</span>
          <h2>On axis for the pan</h2>
          <p>Two centering adapters hold the pan tilt head in the middle of the pipe. Every system is supplied with a 75 mm adapter and a 150 mm adapter, so a rotation sees the wall evenly and the head stays on axis in those diameters.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">75 mm</span><span class="v">Centering adapter</span></div>
            <div class="row"><span class="k">150 mm</span><span class="v">Centering adapter</span></div>
            <div class="row"><span class="k">Supplied</span><span class="v">Both, with the system</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
