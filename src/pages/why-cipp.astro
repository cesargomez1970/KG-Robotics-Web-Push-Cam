---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Why CIPP? — KG Robotics';
const description =
  'Cured-In-Place Pipe (CIPP) is the leading no-dig method for sewer rehabilitation. Learn how it works, why operators choose it, and how KG Robotics UV LED curing systems fit in.';

const steps = [
  {
    n: '01',
    title: 'Prepare the host pipe',
    body: 'A CCTV inspection survey assesses condition and confirms CIPP is the right repair method. The host pipe is then cleaned to remove debris, roots and blockages — ready for liner installation.',
  },
  {
    n: '02',
    title: 'Insert & cure the liner',
    body: 'A resin-impregnated liner is installed through an access point and cured in place using ambient temperature, heat, steam, UV or LED light. The result is a new structural pipe within the existing host, with a design life of up to 50 years.',
  },
  {
    n: '03',
    title: 'Inspect & reinstate',
    body: 'After cure, the pipe is surveyed again to confirm a successful installation. Lateral connections are reopened with a cutting robot where required. The line is then returned to service.',
  },
];

const benefits = [
  {
    title: 'Minimal disruption',
    body: 'No excavation or open-cut digging — CIPP repairs the pipe from existing access points, reducing impact on traffic, property and the surrounding environment.',
  },
  {
    title: 'Fast installation',
    body: 'Modern curing methods — especially LED — shorten on-site time. Quick cure cycles mean less crew downtime and faster return to service.',
  },
  {
    title: 'Structural integrity',
    body: 'CIPP restores and reinforces damaged pipes, addressing cracks, joint failure and root intrusion while preventing further deterioration and collapse.',
  },
  {
    title: 'Reduced infiltration',
    body: 'A continuous liner seals joints and defects, cutting groundwater infiltration and helping networks meet leakage and capacity targets.',
  },
  {
    title: 'Long-lasting results',
    body: 'Properly installed CIPP is a durable, long-life solution — typically 50 years — with far less ongoing maintenance than patchwork repairs.',
  },
  {
    title: 'Cost-effective',
    body: 'Compared with full pipe replacement, CIPP avoids the cost and disruption of excavation, reinstatement and extended project timelines.',
  },
];

const applications = [
  'Wastewater and sewer networks',
  'Domestic and commercial drainage',
  'Stormwater and surface drains',
  'Pressure pipes and rising mains',
  'Industrial and process pipelines',
];

const solutions = [
  {
    href: '/family/led',
    title: 'UV LED curing systems',
    desc: 'Patent-pending LED heads for laterals, mainlines and large diameters — faster cures, lower energy demand and field-proven reliability.',
    image: '/images/sewerlight-600.png',
  },
  {
    href: '/family/cutting',
    title: 'Cutting robots',
    desc: 'Re-open lateral connections after cure with precision cutting robots designed for the post-CIPP workflow.',
    image: '/images/img-011.jpg',
  },
  {
    href: '/family/inspection',
    title: 'Visual inspection',
    desc: 'CCTV before and after every job — push cameras, crawlers and zoom systems to document condition and verify the repair.',
    image: '/images/pipecruiser-hd-100.png',
  },
];
---

<BaseLayout title={title} description={description} activeFam="led">
  <section class="block">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="sep">/</span><a href="/family/led">Pipe Renovation</a><span class="sep">/</span><span class="title-mixed">Why CIPP?</span>
      </div>
      <div class="sec-head">
        <span class="eyebrow muted">Trenchless rehabilitation</span>
        <h1 class="title-mixed">Why CIPP?</h1>
        <p>
          Cured-In-Place Pipe (CIPP) is one of the most widely used methods for sewer rehabilitation — a structural no-dig repair that creates a new pipe within the damaged host, without disruptive and expensive excavation.
        </p>
        <div class="cipp-led-intro">
          <h2>Why UV LED Curing?</h2>
          <p>
            Once the liner is in the pipe, curing sets the pace of the whole job. LED heads send a controlled burst of UV light through the resin — no boilers to fire up, no steam hoses to rig, none of the bulky lamp assemblies that still define older CIPP setups. The equipment is built to travel light: lower power draw, fewer auxiliary machines on the truck, and heads that are working within minutes of arrival on site.
          </p>
          <p>
            On a house connection, a crowded urban main or a basement stack, that difference shows up immediately — less noise at the manhole, less clutter around the access point, and a crew that can move on sooner. Resin stays inactive in the liner until the LED reaches it, so impregnation can be handled before anyone opens the chamber. Every KG Robotics head carries an onboard camera: the operator watches the cure as it happens and keeps the footage for the job file. Shorter time in the hole, less to maintain between projects, and a structural repair you can stand behind.
          </p>
        </div>
      </div>
      <div class="family-intro">
        <div class="family-img">
          <img src="/images/img-004.jpg" alt="CIPP liner curing inside a sewer mainline" loading="lazy" />
        </div>
        <div class="copy">
          <p>
            Every day, operators worldwide choose CIPP to renew ageing sewer networks from manholes and access chambers — restoring capacity, stopping infiltration and extending asset life while keeping streets and properties intact.
          </p>
          <p>
            The method works across diameters from house connections to large mainlines. How you cure the liner — and what you bring to the manhole — is where projects win or lose time.
          </p>
          <p>
            KG Robotics builds the systems that support the full CIPP workflow: inspect the pipe, cure the liner, cut laterals and validate the repair — engineered in Poland for reliable performance at a fraction of the CAPEX of legacy platforms.
          </p>
          <a href="/contact" class="btn btn-accent">
            Talk to our team <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="van-fit-steps cipp-steps">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow muted">The process</span>
        <h2>How a CIPP repair works</h2>
        <p>Fast, efficient and far less disruptive than open-cut replacement — three stages from survey to service.</p>
      </div>
      <div class="steps-grid steps-grid--3">
        {steps.map((step) => (
          <article class="step-card">
            <span class="step-n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="family-advantages">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow muted">Why choose CIPP</span>
        <h2>CIPP vs traditional pipe replacement</h2>
        <p>Compared with dig-and-replace methods, CIPP delivers measurable advantages on almost every project.</p>
      </div>
      <div class="advantages-grid">
        {benefits.map((item) => (
          <article class="advantage">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block cipp-applications">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow muted">Applications</span>
        <h2>Where CIPP is used</h2>
        <p>The go-to repair method across municipal, commercial and industrial networks.</p>
      </div>
      <ul class="cipp-app-list">
        {applications.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow muted">Complete workflow</span>
        <h2>CIPP solutions from KG Robotics</h2>
        <p>Everything you need to inspect, cure, cut and validate — from one manufacturer.</p>
      </div>
      <div class="product-grid">
        {solutions.map((item) => (
          <a class="card" href={item.href}>
            <div class="ph">
              <img src={item.image} alt={item.title} loading="lazy" />
            </div>
            <div class="card-body">
              <div class="pname">{item.title}</div>
              <p>{item.desc}</p>
              <span class="card-link">
                Explore range{' '}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="van-fit-cta">
        <p>Ready to explore UV LED curing for your CIPP projects? Our team can help you match the right system to your diameters, resins and deployment model.</p>
        <a href="/contact" class="btn btn-accent">
          Book a demo <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
