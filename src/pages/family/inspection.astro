---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Visual Inspection — KG Robotics";
const description = "Push cameras, crawlers and zoom cameras for sewer inspection.";
const content = "<section class=\"block\"><div class=\"wrap\">\n    <div class=\"crumbs\"><a href=\"/\">Home</a><span class=\"sep\">/</span><span>Sewer Inspection Systems</span></div>\n    <div class=\"sec-head\"><span class=\"eyebrow muted\">Product Family</span><h1>Sewer Inspection Systems</h1><p>Push cameras, robotic crawlers and zoom manhole cameras — field-proven, low-CAPEX inspection.</p></div>\n    <div class=\"family-intro\">\n      <div class=\"family-img\"><img src=\"/images/img-006.jpg\" alt=\"Sewer Inspection Systems\"/></div>\n      <div class=\"copy\"><p>KG Robotics supplies a complete range of solutions for the visual inspection of sewer networks: push cameras, robotic crawler systems and zoom cameras for the inspection of manholes.</p><p>Every design is extensively field-proven, with decades of industrial service behind it. We focus our innovation on containing production cost — avoiding any increase in our customers' CAPEX — and concentrate on what truly matters: a robust, reliable tool, equal to the harsh conditions inside a sewer network. Contained investment and controlled maintenance cost, without sacrificing efficiency or quality of work.</p></div>\n    </div>\n    <div class=\"product-grid\"><a class=\"card\" href=\"/product/rapido-pro\"><div class=\"ph\"><img src=\"/images/rapido-pro.png\" alt=\"Rapido Pro\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">Rapido Pro</div><div class=\"ptag\">Push camera system</div><p>A rugged push-camera reel for fast, flexible inspection of laterals and house connections — high-resolution imaging with simple, durable handling.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/product/pipecruiser-150\"><div class=\"ph\"><img src=\"/images/pipecruiser-hd-100.png\" alt=\"PipeCruiser 150\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">PipeCruiser 150</div><div class=\"ptag\">Entry-level robotic crawler</div><p>Compact KG97 crawler with matching pan-tilt-zoom camera for pipes from 75 mm — same control platform as PipeCruiser 250, expandable to the larger KG100 chassis and full-size camera when your programme grows.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/product/pipecruiser-250\"><div class=\"ph\"><img src=\"/images/pipecruiser-250.png\" alt=\"PipeCruiser 250\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">PipeCruiser 250</div><div class=\"ptag\">Robotic crawler</div><p>Motorized HD sewer inspection system for mainlines and laterals — 6×6 steerable crawler, pan-tilt-zoom camera and up to 300 m of umbilical cable. The control unit records images and video and generates reports according to EN 13508-2. Two interchangeable crawlers (KG97 and KG100) and two zoom camera options scale the platform from 75 mm (3″) to 500 mm (20″).</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/product/pipecruiser-800\"><div class=\"ph\"><img src=\"/images/img-015.jpg\" alt=\"PipeCruiser 800\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">PipeCruiser 800</div><div class=\"ptag\">Robotic crawler · larger diameter</div><p>A larger, higher-traction crawler for bigger diameters and demanding surveys — engineered for endurance over extended inspection campaigns.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/van-fitting\"><div class=\"ph\"><img src=\"/images/van-fitting-interior.png\" alt=\"Van Fitting\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">Van Fitting</div><div class=\"ptag\">CCTV inspection vehicle</div><p>Complete fit-out of a CCTV inspection van — integrating cameras, reels, control and power into a mobile workstation for field crews.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/product/sewerzoom\"><div class=\"ph\"><img src=\"/images/img-017.jpg\" alt=\"SewerZoom\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">SewerZoom</div><div class=\"ptag\">Zoom manhole camera</div><p>A high-zoom camera for rapid manhole inspection from the surface — survey structures quickly and safely without confined-space entry.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a></div>\n  </div></section>";
const activeFam = "inspection";
---
<BaseLayout title={title} description={description} activeFam={activeFam}>
  <Fragment set:html={content} />
</BaseLayout>
