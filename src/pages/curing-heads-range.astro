---
import BaseLayout from '../layouts/BaseLayout.astro';
import { curingHeads as heads } from '../data/curing-heads';

const title = 'LED heads range — KG Robotics';
const description =
  'UV-C curing heads for the KG SewerLight UV LED Lite system — Extra Small and Small heads for DN75 to DN250, with integrated live-view inspection.';
---

<BaseLayout title={title} description={description} activeFam="led">
  <section class="block">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="sep">/</span><a href="/family/led">Pipe Renovation</a><span class="sep">/</span><span class="title-mixed">LED heads range</span>
      </div>
      <div class="sec-head">
        <span class="eyebrow muted">SewerLight UV LED Curing system</span>
        <h1 class="title-mixed">LED heads range</h1>
        <p>
          Interchangeable UV curing heads for the KG SewerLight UV LED Lite platform — matched to pipe diameter, output demand and bend geometry. Both heads share quick-release connection, patented cooling, onboard live-view camera and rapid glass replacement, so crews can swap between lateral and mainline work without changing the core system.
        </p>
      </div>

      <div class="curing-heads-overview">
        {
          heads.map((head) => (
            <a class="curing-head-overview" href={`#${head.id}`}>
              <span class="curing-head-overview-tag">Curing head · {head.name}</span>
              <h2>{head.model}</h2>
              <p>{head.overview}</p>
              <ul>
                <li><span>DN range</span><strong>{head.highlights.find((h) => h.label === 'DN range')?.value}</strong></li>
                <li><span>Power</span><strong>{head.highlights.find((h) => h.label === 'Total power')?.value}</strong></li>
                <li><span>Weight</span><strong>{head.highlights.find((h) => h.label === 'Weight')?.value.split(' ·')[0]}</strong></li>
              </ul>
              <span class="curing-head-overview-more">Full specifications ↓</span>
            </a>
          ))
        }
      </div>

      <div class="curing-heads-pdf-wrap">
        <a href="/documents/kg-robotics-uv-curing-heads.pdf" class="btn btn-dark" target="_blank" rel="noopener">
          Download datasheet (PDF) <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
        </a>
      </div>

      <div class="curing-heads-list">
        {
          heads.map((head) => (
            <article class="curing-head-card" id={head.id}>
              <div class="curing-head-grid">
                <div class="curing-head-visual">
                  <img src={head.image} alt={head.imageAlt} loading="lazy" />
                </div>
                <div class="curing-head-copy">
                  <span class="eyebrow muted">Curing head · {head.name}</span>
                  <h2>{head.model}</h2>
                  <p>{head.summary}</p>
                  <ul class="curing-head-highlights">
                    {head.highlights.map((item) => (
                      <li>
                        <span class="k">{item.label}</span>
                        <span class="v">{item.value}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="curing-head-specs">
                {head.sections.map((section) => (
                  <div class="curing-head-spec-block">
                    <h3>{section.title}</h3>
                    <div class="pd-specs">
                      {section.rows.map(([k, v]) => (
                        <div class="row">
                          <span class="k">{k}</span>
                          <span class="v">{v}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <div class="curing-heads-cta">
        <p>Both heads run on the SewerLight UV LED system — explore the full platform or talk to our team about matching head and hose length to your diameters.</p>
        <div class="curing-heads-cta-actions">
          <a href="/product/sewerlight-600" class="btn btn-dark">
            SewerLight 600 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="/contact" class="btn btn-accent">
            Book a demo <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
