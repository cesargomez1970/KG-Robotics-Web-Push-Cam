---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'PipeCruiser 250 — KG Robotics';
const description =
  'Motorized HD sewer inspection for mainlines and laterals — 6×6 steerable crawler, pan-tilt-zoom camera, up to 300 m umbilical and EN 13508-2 reporting.';

const systemGallery = [
  { src: '/images/pipecruiser-250-crawler.png', alt: 'PipeCruiser 250 — 6×6 steerable crawler with pan-tilt-zoom camera' },
  { src: '/images/pipecruiser-hd-100-system-01.png', alt: 'PipeCruiser 250 — crawler, reel cart and control unit' },
  { src: '/images/pipecruiser-hd-100-system-03.png', alt: 'PipeCruiser 250 — complete mobile inspection system' },
];

const configGallery = [
  { src: '/images/pipecruiser-250-crawler.png', alt: 'PipeCruiser — KG97 crawler with pan-tilt camera head' },
  { src: '/images/pipecruiser-250-config-02.png', alt: 'PipeCruiser — six-wheel crawler configuration' },
  { src: '/images/pipecruiser-250-config-03.png', alt: 'PipeCruiser — KG100 crawler with compact zoom camera' },
  { src: '/images/pipecruiser-250-config-04.png', alt: 'PipeCruiser — crawler and camera combinations' },
];

const wheelGallery = [
  { src: '/images/pipecruiser-250-wheels-01.png', alt: 'PipeCruiser — crawler with interchangeable wheel sets, top view' },
  { src: '/images/pipecruiser-250-wheels-02.png', alt: 'PipeCruiser — pan-tilt camera head and wheel options' },
  { src: '/images/pipecruiser-250-wheels-03.png', alt: 'PipeCruiser — 6×6 crawler and interchangeable wheels' },
];
---

<BaseLayout title={title} description={description} activeFam="inspection">
  <section class="block">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="sep">/</span><a href="/family/inspection">Sewer Inspection Systems</a><span class="sep">/</span><span
          >PipeCruiser 250</span
        >
      </div>
      <div class="pd-grid">
        <div class="pd-img pd-img--carousel">
          <div class="pd-carousel" data-interval="5200">
            {
              systemGallery.map((item, index) => (
                <img
                  class:list={['pd-carousel-slide', { active: index === 0 }]}
                  src={item.src}
                  alt={item.alt}
                  width="1024"
                  height="1024"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
          </div>
        </div>
        <div class="pd-info">
          <span class="eyebrow muted">Sewer Inspection Systems</span>
          <h1>PipeCruiser 250</h1>
          <div class="ptag">Robotic crawler</div>
          <p class="desc">
            Motorized HD sewer inspection system for mainlines and laterals — 6×6 steerable crawler, pan-tilt-zoom camera and up to 300 m of umbilical
            cable. The control unit records images and video and generates reports according to EN 13508-2. Two interchangeable crawlers (KG97 and KG100) and two
            zoom camera options scale the platform from 75 mm (3″) to 500 mm (20″).
          </p>
          <div class="pd-specs">
            <div class="row">
              <span class="k">CIPP APPLICATION</span><span class="v">Robotic crawler for sewer pipes</span>
            </div>
            <div class="row">
              <span class="k">Inspecting range</span><span class="v">100–500 mm (4″–20″)</span>
            </div>
            <div class="row">
              <span class="k">Control unit</span><span class="v">IP54 rated, reporting software, image/video storage, keyboard</span>
            </div>
            <div class="row">
              <span class="k">Camera</span><span class="v">Interchangeable, pan-tilt, zoom</span>
            </div>
            <div class="row">
              <span class="k">Crawler</span><span class="v">6×6, steerable, interchangeable wheels</span>
            </div>
            <div class="row">
              <span class="k">Cable reel</span><span class="v">Portable, manual, motorized</span>
            </div>
            <div class="row">
              <span class="k">Cable length</span><span class="v">100 m, 200 m or 300 m</span>
            </div>
          </div>
          <div class="pd-actions">
            <a href="/contact" class="btn btn-accent">
              Request information <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="/family/inspection" class="btn btn-dark">Back to overview</a>
          </div>
        </div>
      </div>

      <div class="pc-wheels">
        <div class="drycore-split">
          <div class="copy">
            <div class="sec-head drycore-split-head">
              <span class="eyebrow muted">Range positioning</span>
              <h2>PipeCruiser 150 vs 250 — size at a glance</h2>
            </div>
            <p class="pc-wheels-lead">Compact entry vs full-size platform</p>
            <p>
              Both models share the same 6×6 steerable architecture, pan-tilt-zoom imaging and control-unit workflow — but they are built around different
              chassis and camera scales. <strong>PipeCruiser 150</strong> pairs the compact <strong>KG97</strong> crawler with the matching compact camera
              head: a lower, narrower profile for laterals and small mains from 75&nbsp;mm (3″). <strong>PipeCruiser 250</strong> adds the larger
              <strong>KG100</strong> chassis and the full-size zoom camera — bigger wheels, a taller camera housing and the traction envelope needed for
              mainline surveys up to 500&nbsp;mm (20″).
            </p>
            <p>
              The render shows the difference side by side: the 250 in the foreground carries larger-diameter wheels and a bulkier camera assembly; the 150
              behind it keeps the same visual language in a noticeably smaller package. Operators who start on the 150 can move up to the 250 hardware on the
              same cart and control platform — see the <a href="/product/pipecruiser-150">PipeCruiser 150</a> upgrade path.
            </p>
          </div>
          <figure class="drycore-figure">
            <img
              src="/images/pipecruiser-150-250-size-comparison.png"
              alt="PipeCruiser 150 and PipeCruiser 250 crawlers — size comparison"
              loading="lazy"
              width="1024"
              height="1024"
            />
            <figcaption>KG97 compact chassis (150) and KG100 full-size platform (250) — same family, different scale.</figcaption>
          </figure>
        </div>
      </div>

      <div class="pc-wheels">
        <div class="pc-wheels-head">
          <span class="eyebrow muted">Platform</span>
          <h2>System configurations</h2>
          <p class="pc-wheels-lead">Two crawlers, two cameras</p>
          <p>
            The PipeCruiser inspection system is built around two crawlers — the <strong>KG97</strong> for pipes from 75 mm (3″), and the <strong>KG100</strong> for
            diameters from 100 mm (4″) upward. The smaller chassis takes the compact KG97 camera head: a narrower profile than the larger option, with the same
            pan-tilt-zoom control and HD image quality. Together, the small crawler, compact camera and 200 m manual reel make a strong entry-level package for
            everyday inspection work.
          </p>
        </div>
        <div class="pc-wheels-gallery pc-wheels-gallery--4">
          {
            configGallery.map((item) => (
              <figure>
                <img src={item.src} alt={item.alt} loading="lazy" width="1024" height="1024" />
              </figure>
            ))
          }
        </div>
      </div>

      <div class="pc-wheels">
        <div class="pc-wheels-head">
          <span class="eyebrow muted">Crawler configuration</span>
          <h2>Interchangeable wheels</h2>
          <p>
            The PipeCruiser range includes a family of interchangeable wheel sets so operators can match crawler geometry to the inspection cross-section and
            traction to pipe surface conditions — whether the host is rough cast iron, glazed ceramic or a freshly cured liner.
          </p>
        </div>
        <div class="pc-wheels-gallery">
          {
            wheelGallery.map((item) => (
              <figure>
                <img src={item.src} alt={item.alt} loading="lazy" width="1024" height="1024" />
              </figure>
            ))
          }
        </div>
      </div>

      <div class="pd-more">
        <h3>More in this family</h3>
        <div class="chip-row">
          <a class="chip" href="/product/rapido-pro">
            Rapido Pro <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/product/pipecruiser-150">
            PipeCruiser 150 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/product/pipecruiser-800">
            PipeCruiser 800 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/van-fitting">
            Van Fitting <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/product/sewerzoom">
            SewerZoom <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
