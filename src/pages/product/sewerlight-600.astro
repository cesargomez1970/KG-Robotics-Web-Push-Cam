---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { curingHeads } from '../../data/curing-heads';

const title = 'SewerLight 600 — KG Robotics';
const description =
  'SewerLight 600 — UV LED curing for laterals and small-to-mid mainlines. DryCore™ isolates site compressed air from LED emitters for stable irradiance and longer maintenance intervals.';

const systemGallery = [
  { src: '/images/sewerlight-600-system-01.png', alt: 'SewerLight 600 — complete UV LED curing system' },
  { src: '/images/sewerlight-600-system-02.png', alt: 'SewerLight 600 — reel cart, control unit and curing head' },
  { src: '/images/sewerlight-600-system-03.png', alt: 'SewerLight 600 — tripod-mounted head and mobile reel unit' },
  { src: '/images/sewerlight-600-system-04.png', alt: 'SewerLight 600 — rugged control case and curing assembly' },
  { src: '/images/sewerlight-600-system-05.png', alt: 'SewerLight 600 — mobile platform with monitor and reel' },
];
---

<BaseLayout title={title} description={description} activeFam="led">
  <section class="block">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="sep">/</span><a href="/family/led">UV LED Curing Systems</a><span class="sep">/</span><span
          >SewerLight 600</span
        >
      </div>
      <div class="pd-grid">
        <div class="pd-img pd-img--carousel">
          <div class="pd-carousel" data-interval="5200">
            {
              systemGallery.map((item, index) => (
                <img
                  class:list={['pd-carousel-slide', { active: index === 0 }]}
                  src={item.src}
                  alt={item.alt}
                  width="1024"
                  height="1024"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
          </div>
        </div>
        <div class="pd-info">
          <span class="eyebrow muted">UV LED Curing Systems</span>
          <h1>SewerLight 600</h1>
          <div class="ptag">Laterals & small mainlines</div>
          <p class="desc">
            UV LED curing system for laterals and small-to-mid diameter mainlines. Interchangeable ZENITH heads, mobile reel cart and rugged control
            electronics. Ultra-efficient head design for faster curing involving less air flow and a smaller compressor. DryCore™ LED elements cooling
            technology isolates the compressed-air circuit entirely from the optical and electronic assembly. The LED emitters and their PCBs are never
            exposed to the moisture, oil carry-over or particulate typically present in site air supplies. The result is stable irradiance throughout the
            service life of the equipment, longer maintenance intervals and fewer unplanned stoppages on site.
          </p>
          <div class="pd-specs">
            <div class="row">
              <span class="k">CIPP APPLICATION</span><span class="v">Laterals & small mainlines</span>
            </div>
            <div class="row">
              <span class="k">DN range</span><span class="v">75–250 mm (3″–10″)</span>
            </div>
            <div class="row">
              <span class="k">WAVELENGTH</span><span class="v">400 nm (UV)</span>
            </div>
            <div class="row">
              <span class="k">COOLING TECHNOLOGY</span><span class="v">Contactless DryCore™</span>
            </div>
            <div class="row">
              <span class="k">Curing heads</span><span class="v">ZENITH 300W (XS) · ZENITH 600W (S)</span>
            </div>
            <div class="row">
              <span class="k">HOSE - CABLE</span><span class="v">Up to 60 m flexible umbilical hose</span>
            </div>
            <div class="row">
              <span class="k">WEIGHT</span><span class="v">Lighter than you expect</span>
            </div>
          </div>
          <div class="pd-actions">
            <a href="/contact" class="btn btn-accent">
              Request information <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="/curing-heads-range" class="btn btn-dark">LED heads range</a>
            <a href="/family/led" class="btn btn-dark">Back to overview</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block alt" id="curing-heads">
    <div class="wrap">
      <div class="sec-head sl600-heads-intro">
        <span class="eyebrow muted">Interchangeable heads</span>
        <h2>ZENITH UV LED curing heads</h2>
        <p>
          The SewerLight 600 is compatible with the following UV LED curing heads. The quick-connect system allows curing heads to be swapped
          simply and quickly — so crews can match diameter and output without changing the core platform.
        </p>
      </div>

      <div class="curing-heads-list">
        {
          curingHeads.map((head) => (
            <article class="curing-head-card">
              <div class="curing-head-grid">
                <div class="curing-head-visual">
                  <img src={head.image} alt={head.imageAlt} loading="lazy" />
                </div>
                <div class="curing-head-copy">
                  <span class="eyebrow muted">Curing head · {head.name}</span>
                  <h3>{head.model}</h3>
                  <p>{head.summary}</p>
                  <ul class="curing-head-highlights">
                    {head.highlights.map((item) => (
                      <li>
                        <span class="k">{item.label}</span>
                        <span class="v">{item.value}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="curing-head-specs">
                {head.sections.map((section) => (
                  <div class="curing-head-spec-block">
                    <h4>{section.title}</h4>
                    <div class="pd-specs">
                      {section.rows.map(([k, v]) => (
                        <div class="row">
                          <span class="k">{k}</span>
                          <span class="v">{v}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <p class="sl600-heads-foot">
        <a href="/documents/kg-robotics-uv-curing-heads.pdf" class="btn btn-dark" target="_blank" rel="noopener">
          Download curing heads datasheet (PDF) <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
        </a>
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="pd-more">
        <h3>More in this family</h3>
        <div class="chip-row">
          <a class="chip" href="/product/sewerlight-1200">
            SewerLight 1200 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/product/sewerchain-2400">
            SewerChain 2400 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/product/nanolight-100">
            NanoLight 100 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
