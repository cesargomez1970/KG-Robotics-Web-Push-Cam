---
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
const partnerClass = tone === 'dark' ? 'btn-ghost' : 'btn-dark';
---
<div class:list={['sales-ctas', className]}>
  <a href="/distributors" class:list={['btn', partnerClass]}>Become a distributor</a>
  <a href="/contact" class="btn btn-accent">Request more information <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
</div>
