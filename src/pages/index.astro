---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroProductOverlays from '../components/HeroProductOverlays.astro';

const title = "KG Robotics — Inspection & Rehabilitation Systems for Sewer Networks";
const description = "KG Robotics designs and manufactures UV LED curing systems, cutting solutions and visual inspection equipment for sewer networks. Made in Poland, engineered for low CAPEX.";
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-slides">
      <div class="hero-slide active" style="background-image:url('/images/hero-street-cipp.jpg')"></div>
      <div class="hero-slide" style="background-image:url('/images/img-001.jpg')"></div>
      <div class="hero-slide" style="background-image:url('/images/img-002.jpg')"></div>
      <div class="hero-slide" style="background-image:url('/images/img-003.jpg')"></div>
      <div class="hero-slide" style="background-image:url('/images/hero-manhole.png')"></div>
    </div>
    <div class="hero-overlay"></div>
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Inspect → Renovate → Validate</span>
          <h1 data-i18n-html="heroH1">
            <span class="hero-h1-line hero-h1-line--down">CIPP <span class="o">Trenchless</span> Solutions</span>
            <span class="hero-h1-line hero-h1-line--up">AND <span class="o">SEWER</span> Visual Inspection</span>
          </h1>
          <p class="lead">Cure-in-Place-Pipe UV LED curing systems, cutting robots and visual inspection equipment — engineered in Poland to deliver reliable performance at a fraction of the CAPEX.</p>
          <div class="hero-actions">
            <a href="/family/led" class="btn btn-accent">Explore Products <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            <a href="/about" class="btn btn-ghost">About KG Robotics</a>
          </div>
        </div>
      </div>
    </div>
    <HeroProductOverlays />
  </section>

  <div class="values">
    <div class="wrap">
      <div class="grid values-grid">
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2v6m0 0 3-3m-3 3L9 5"/><rect x="4" y="8" width="16" height="13" rx="2"/><path d="M9 13h6M9 17h6"/></svg>
          <h3>UV LED Curing</h3>
          <p>Patent-pending LED systems for trenchless rehabilitation — from laterals at 80 mm to large-diameter mainlines.</p>
          <a href="/product/sewerlight-600" class="value-product">
            <img src="/images/sewerlight-600.png" alt="SewerLight 600" />
            <span class="value-product-label">SewerLight 600</span>
          </a>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/></svg>
          <h3>Cutting Robots</h3>
          <p>Air-powered cutters for milling obstructions and lateral reinstatement during pipe rehabilitation.</p>
          <a href="/product/sewercut-100" class="value-product">
            <img src="/images/img-011.jpg" alt="SewerCut 100" />
            <span class="value-product-label">SewerCut 100</span>
          </a>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <h3>Visual Inspection</h3>
          <p>Push cameras, HD crawlers and zoom systems — field-proven imaging at a fraction of the CAPEX.</p>
          <a href="/product/pipecruiser-250" class="value-product">
            <img src="/images/pipecruiser-hd-100.png" alt="PipeCruiser 250" />
            <span class="value-product-label">PipeCruiser 250</span>
          </a>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 17h8M6 11h12M7 7h10"/><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 17v2M17 17v2"/></svg>
          <h3>Van Fitting</h3>
          <p>Turnkey design and supply of CCTV inspection vans — your mobile HQ with KG Robotics systems integrated.</p>
          <a href="/van-fitting" class="value-product">
            <img src="/images/van-fitting-interior.png" alt="Van Fitting" />
            <span class="value-product-label">Van Fitting</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow muted">Product Range</span>
        <h2>Explore our product families</h2>
        <p>Four families covering trenchless rehabilitation, milling, and visual inspection — for sewer networks and industrial assets.</p>
      </div>
      <div class="fam-grid">
        <a class="fam-card" href="/family/led">
          <img src="/images/img-004.jpg" alt="UV LED Curing Systems" />
          <div class="fc-body">
            <h3>UV LED Curing Systems</h3>
            <p>Patent-pending LED light-curing systems for trenchless rehabilitation of sewer networks, from 80 mm.</p>
            <span class="more">Explore the range <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
        <a class="fam-card" href="/family/cutting">
          <img src="/images/img-005.jpg" alt="Cutting Robots" />
          <div class="fc-body">
            <h3>Cutting Robots</h3>
            <p>Robust, air-powered cutters for milling and lateral reinstatement during pipe rehabilitation.</p>
            <span class="more">Explore the range <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
        <a class="fam-card" href="/family/inspection">
          <img src="/images/img-006.jpg" alt="Visual Inspection Systems" />
          <div class="fc-body">
            <h3>Visual Inspection Systems</h3>
            <p>Push cameras, robotic crawlers and zoom manhole cameras — field-proven, low-CAPEX inspection.</p>
            <span class="more">Explore the range <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
        <a class="fam-card" href="/family/industrial">
          <img src="/images/hero-industrial-2.png" alt="Industrial / RVI" />
          <div class="fc-body">
            <h3>Industrial / RVI</h3>
            <p>Visual Testing (VT) and Remote Visual Inspection (RVI) for industrial pipe networks.</p>
            <span class="more">Explore the range <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
