---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'PipeCruiser 100 HD ATEX — KG Robotics';
const description =
  'ATEX-rated industrial inspection robotic crawler — highly portable HD RVI system that packs into two transport cases, with optional site trolley for control, reel and crawler.';

const systemGallery = [
  { src: '/images/pipecruiser-100-atex-system-02.png', alt: 'PipeCruiser 100 HD ATEX — crawler, reel and control in two transport cases' },
  { src: '/images/pipecruiser-100-atex-system-01.png', alt: 'PipeCruiser 100 HD ATEX — portable industrial inspection system' },
  { src: '/images/pipecruiser-100-atex-system-03.png', alt: 'PipeCruiser 100 HD ATEX — industrial robotic crawler with manual reel' },
  { src: '/images/pipecruiser-100-atex-trolley-01.png', alt: 'PipeCruiser 100 HD ATEX — optional transport trolley configuration' },
];

const portableGallery = [
  { src: '/images/pipecruiser-100-atex-system-01.png', alt: 'PipeCruiser 100 HD ATEX — complete system layout' },
  { src: '/images/pipecruiser-100-atex-system-02.png', alt: 'PipeCruiser 100 HD ATEX — control unit, reel and crawler' },
  { src: '/images/pipecruiser-100-atex-system-03.png', alt: 'PipeCruiser 100 HD ATEX — field-ready components' },
];

const trolleyGallery = [
  { src: '/images/pipecruiser-100-atex-trolley-01.png', alt: 'PipeCruiser 100 HD ATEX on transport trolley' },
  { src: '/images/pipecruiser-100-atex-trolley-02.png', alt: 'PipeCruiser 100 HD ATEX — control station on trolley' },
  { src: '/images/pipecruiser-100-atex-trolley-03.png', alt: 'PipeCruiser 100 HD ATEX — trolley with reel and storage case' },
  { src: '/images/pipecruiser-100-atex-trolley-04.png', alt: 'PipeCruiser 100 HD ATEX — mobile workstation with crawler' },
];
---

<BaseLayout title={title} description={description} activeFam="industrial">
  <section class="block">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="sep">/</span><a href="/family/industrial">Industrial / RVI</a><span class="sep">/</span><span
          >PipeCruiser 100 HD ATEX</span
        >
      </div>
      <div class="pd-grid">
        <div class="pd-img pd-img--carousel">
          <div class="pd-carousel" data-interval="5200">
            {
              systemGallery.map((item, index) => (
                <img
                  class:list={['pd-carousel-slide', { active: index === 0 }]}
                  src={item.src}
                  alt={item.alt}
                  width="1024"
                  height="1024"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
          </div>
        </div>
        <div class="pd-info">
          <span class="eyebrow muted">Industrial / RVI</span>
          <h1>PipeCruiser 100 HD ATEX</h1>
          <div class="ptag">ATEX · hazardous-area RVI</div>
          <p class="desc">
            The PipeCruiser 100 HD ATEX brings HD remote visual inspection into classified zones — without the footprint of a fixed CCTV van. The
            <strong>industrial inspection robotic crawler</strong>, manual cable reel and rugged control station are designed as a <strong>highly portable</strong>
            field system: for most deployments the hardware packs into <strong>two transport cases</strong> that fit a standard vehicle and a small crew. On site,
            the same modules can be set up bench-style for quick surveys, or assembled on the <strong>optional transport trolley</strong> when you want a single
            rolling workstation for control, storage and cable management.
          </p>
          <div class="pd-specs">
            <div class="row">
              <span class="k">Category</span><span class="v">Industrial inspection robotic crawler</span>
            </div>
            <div class="row">
              <span class="k">Certification</span><span class="v">ATEX-rated for hazardous atmospheres</span>
            </div>
            <div class="row">
              <span class="k">Control unit</span><span class="v">Monitor, keyboard and joysticks. Video &amp; image storage</span>
            </div>
            <div class="row">
              <span class="k">Camera</span><span class="v">HD video, pan-tilt, zoom</span>
            </div>
            <div class="row">
              <span class="k">Crawler</span><span class="v">6×6 drive, steerable</span>
            </div>
            <div class="row">
              <span class="k">Cable reel</span><span class="v">Portable manual reel with depth counter</span>
            </div>
            <div class="row">
              <span class="k">Portability</span><span class="v">Two transport cases — crawler, reel &amp; control</span>
            </div>
            <div class="row">
              <span class="k">Accessories</span><span class="v">Optional transport trolley</span>
            </div>
          </div>
          <div class="pd-actions">
            <a href="/contact" class="btn btn-accent">
              Request information <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="/family/industrial" class="btn btn-dark">Back to overview</a>
          </div>
        </div>
      </div>

      <div class="pc-wheels">
        <div class="pc-wheels-head">
          <span class="eyebrow muted">Deployment</span>
          <h2>Two cases, ready for the plant</h2>
          <p class="pc-wheels-lead">Highly portable by design</p>
          <p>
            Mobility is built in, not bolted on. The crawler, reel and control console break down into a compact footprint so technicians can move the system
            through permit gates, narrow corridors and mezzanines without a dedicated inspection vehicle. For typical call-outs, everything travels in
            <strong>two rugged transport cases</strong> — one for the crawler and reel, one for the control station — so loading, security checks and site
            logistics stay straightforward. Unpack, connect the umbilical, and you are inspecting; repack just as quickly when the shift ends.
          </p>
        </div>
        <div class="pc-wheels-gallery">
          {
            portableGallery.map((item) => (
              <figure>
                <img src={item.src} alt={item.alt} loading="lazy" width="1024" height="1024" />
              </figure>
            ))
          }
        </div>
      </div>

      <div class="pc-wheels">
        <div class="pc-wheels-head">
          <span class="eyebrow muted">Platform</span>
          <h2>Built for industrial pipe RVI</h2>
          <p class="pc-wheels-lead">Industrial inspection robotic crawler</p>
          <p>
            At the centre of the system is the <strong>industrial inspection robotic crawler</strong> — a low-profile, high-traction chassis for horizontal and
            vertical runs in process pipe, off-site lines and other confined assets where human entry is restricted. HD imaging, pan-tilt aiming and field-proven
            mechanical design support Visual Testing and Remote Visual Inspection programmes in demanding environments, including ATEX-classified areas when
            equipped and operated according to certification. The same architecture used in sewer PipeCruiser systems, re-engineered for industrial duty and
            explosive-atmosphere compliance.
          </p>
        </div>
      </div>

      <div class="pc-wheels">
        <div class="pc-wheels-head">
          <span class="eyebrow muted">Optional equipment</span>
          <h2>Transport trolley</h2>
          <p class="pc-wheels-lead">Roll the workstation to the job</p>
          <p>
            When the site layout suits it, the optional <strong>transport trolley</strong> turns the separate modules into one mobile column: control case on top,
            accessory storage in the centre, cable reel at the base — with the crawler connected and ready at floor level. It is the same portable system, simply
            organised for longer campaigns in a fixed plant area or when crews prefer not to work from bench height. The trolley is not mandatory; the two-case
            configuration remains the default for maximum flexibility.
          </p>
        </div>
        <div class="pc-wheels-gallery pc-wheels-gallery--4">
          {
            trolleyGallery.map((item) => (
              <figure>
                <img src={item.src} alt={item.alt} loading="lazy" width="1024" height="1024" />
              </figure>
            ))
          }
        </div>
      </div>

      <div class="pd-more">
        <h3>More in this family</h3>
        <div class="chip-row">
          <a class="chip" href="/product/rapido-pro-atex">
            Rapido Pro ATEX <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/family/industrial">
            Industrial / RVI overview <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/product/pipecruiser-150">
            PipeCruiser 150 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
