---
import BaseLayout from '../layouts/BaseLayout.astro';
import SalesCtas from '../components/SalesCtas.astro';

const title = 'Rapido Pro — Push Camera for Sewer Inspection | KG Robotics';
const description =
  'Rapido Pro Full HD is a push-camera system for sewer inspection from 40 mm to 300 mm. 60 m reel, KG41 camera with automatic up-right sensor position and a portable control unit. Made in Poland.';

const fieldPhotos = [
  { src: '/images/rapido/07-screen.jpg', alt: 'Control screen showing the pipe interior during a push inspection', portrait: false },
  { src: '/images/rapido/06-camera-head.jpg', alt: 'KG41 camera head resting on the red push-rod reel', portrait: false },
  { src: '/images/rapido/09-feeding.jpg', alt: 'Operator holding the camera head at the manhole, reel cart behind', portrait: false },
  { src: '/images/rapido/10-operator.jpg', alt: 'Operator feeding the red push rod from the reel into the manhole', portrait: false },
  { src: '/images/rapido/11-watching.jpg', alt: 'Operator watching the inspection on the Rapido Pro screen', portrait: false },
  { src: '/images/rapido/12-skid.jpg', alt: 'Operator fitting a centering skid on the camera head', portrait: false },
];

const infographics = [
  { src: '/images/rapido-control-unit.jpg', alt: 'Rapido Pro control unit with screen and keyboard' },
  { src: '/images/rapido-pro-system-02.png', alt: 'Rapido Pro — complete mobile push inspection system' },
  { src: '/images/rapido-pro-system-03.png', alt: 'Rapido Pro — control case, screen and keyboard' },
  { src: '/images/rapido-pro-system-04.png', alt: 'Rapido Pro — wheeled reel cart with the monitor closed' },
];

const rangeSpecs = [
  { label: 'Camera', values: ['KG41 Full HD', 'KG41 Full HD', 'KG41 Full HD'] },
  { label: 'Diameter', values: ['40–300 mm', '40–300 mm', '40–300 mm'] },
  { label: 'Image', values: ['Full HD', 'Full HD', 'Full HD'] },
  { label: 'Push cable', values: ['30 m', '60 m', '90 m'] },
  { label: 'Cable diameter', values: ['9 mm', '11 mm', '12 mm'] },
  { label: 'Sensor position', values: ['Automatic up-right', 'Automatic up-right', 'Automatic up-right'] },
  { label: 'Field of view', values: ['105°', '105°', '105°'] },
  { label: 'Lighting', values: ['4-LED ring', '4-LED ring', '4-LED ring'] },
  { label: 'Bends', values: ['90° from DN75', '90° from DN75', '90° from DN75'] },
  { label: 'Control unit', values: ['Control unit with keyboard', 'Control unit with keyboard', 'Control unit with keyboard'] },
  { label: 'Weight', values: ['20 kg', '28 kg', '36 kg'] },
];

const systemGallery = [
  { src: '/images/rapido-pro.png', alt: 'Rapido Pro — complete push-camera system, front three-quarter view' },
  { src: '/images/rapido-pro-system-01.png', alt: 'Rapido Pro — reel cart, control unit and camera head' },
  { src: '/images/rapido-pro-system-02.png', alt: 'Rapido Pro — side view with battery pack, keyboard and camera head' },
  { src: '/images/hero-overlay-rapido.png', alt: 'Rapido Pro — wheeled reel with monitor open and push rod' },
  { src: '/images/rapido-pro-system-04.png', alt: 'Rapido Pro — rear view with the monitor closed and camera head extended' },
  { src: '/images/rapido-pro-system-03.png', alt: 'Rapido Pro — 10.1 inch touchscreen and keyboard' },
];
---

<BaseLayout title={title} description={description} activeFam="push">
  <section class="hero hero-plain">
    <div class="wrap">
      <div class="hero-grid">
        <span class="eyebrow">Push camera · Full HD</span>
        <h1>
          <span class="hero-h1-line hero-h1-line--down">Rapido <span class="o">Pro</span></span>
          <span class="hero-h1-line hero-h1-line--up"><span class="o">HD</span> push camera</span>
        </h1>
        <figure class="hero-cutout">
          <div class="pd-carousel" data-interval="4000">
            <img class="pd-carousel-slide active" src="/images/rapido-pro-hero-system.png" alt="Rapido Pro push camera system, with the control unit, reel and camera head" width="589" height="961" />
            <img class="pd-carousel-slide" src="/images/rapido-pro-hero-rear.png" alt="Rapido Pro with the monitor closed, seen from the rear" width="589" height="961" />
            <img class="pd-carousel-slide" src="/images/rapido-pro-hero-front.png" alt="Rapido Pro with the screen and keyboard open" width="589" height="961" />
          </div>
        </figure>
        <p class="lead">RAPIDO is a family of push cameras designed for sewer inspection, available in 30, 60 and 90 m. Every system includes a Full HD auto-leveling camera and a control unit with documentation capabilities, all mounted on a sturdy frame with wheels.</p>
        <div class="hero-actions">
          <SalesCtas tone="dark" />
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="system">
    <div class="wrap">
      <div class="sec-head sec-head--intro">
        <p><span class="sec-head-name">RAPIDO <span class="o">PRO</span></span>is the first product from KG ROBOTICS. This push camera family begins a series of systems for sewer inspection and trenchless rehabilitation.</p>
        <p>Stay tuned for what's coming next...</p>
      </div>
      <div class="rapido-range" id="rapido-range">
        <div class="rapido-range-gap"></div>
        <img src="/images/rapido-range.jpg" alt="Three Rapido push-camera reels: Rapido 30, Rapido 60 and Rapido 90" width="875" height="317" />
        <div class="rapido-range-gap"></div>
        <span class="rapido-range-name">Rapido <span class="o">30</span></span>
        <span class="rapido-range-name">Rapido <span class="o">60</span></span>
        <span class="rapido-range-name">Rapido <span class="o">90</span></span>
        {
          rangeSpecs.map((spec) => (
            <>
              <span class="rapido-range-label">{spec.label}</span>
              {spec.values.map((value) => <span class="rapido-range-value">{value}</span>)}
            </>
          ))
        }
      </div>
      <nav class="section-links" aria-label="On this page">
        <a href="#platform"><span>Rapido Pro<small>The system</small></span></a>
        <a href="#record"><span>Built to push<small>Control unit, reel and camera</small></span></a>
        <a href="#camera"><span>KG41 Full HD<small>Camera, bends and push cable</small></span></a>
        <a href="#power"><span>Battery operated<small>Milwaukee pack on the control unit</small></span></a>
        <a href="#onsite"><span>On site<small>One operator</small></span></a>
      </nav>
      <div class="pd-grid" id="platform">
        <div class="pd-img pd-img--carousel">
          <div class="pd-carousel" data-interval="2600">
            {
              systemGallery.map((item, index) => (
                <img
                  class:list={['pd-carousel-slide', { active: index === 0 }]}
                  src={item.src}
                  alt={item.alt}
                  width="1024"
                  height="1024"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
          </div>
        </div>
        <div class="pd-info">
          <span class="eyebrow muted">Push camera system</span>
          <h2>Rapido Pro</h2>
          <div class="ptag">Full HD · 40–300 mm</div>
          <p class="desc">
            The reel cart, control console and camera head work as a single field system. The stainless KG41 body and steel frame are built for the pipe, and centering skids for DN75 and DN150 keep the head on axis in typical lateral sizes.
          </p>
          <div class="pd-specs">
            <div class="row"><span class="k">Inspecting range</span><span class="v">DN40–DN300 mm (1½″–12″)</span></div>
            <div class="row"><span class="k">Camera head</span><span class="v">KG41, 1080p Full HD, automatic up-right sensor position</span></div>
            <div class="row"><span class="k">Optics &amp; lighting</span><span class="v">105° horizontal FOV, 4-LED focused ring</span></div>
            <div class="row"><span class="k">Push rod &amp; reel</span><span class="v">60 m, 512 Hz sonde, metre counter</span></div>
            <div class="row"><span class="k">Control unit</span><span class="v">10.1″ 1080p touchscreen, USB or internal storage</span></div>
            <div class="row"><span class="k">Power</span><span class="v">Milwaukee battery pack or mains adapter</span></div>
            <div class="row"><span class="k">Pipe bends</span><span class="v">From DN75 at 90° (with centering skids)</span></div>
          </div>
          <SalesCtas class="sales-ctas--actions" />
        </div>
      </div>

      <div class="pc-wheels" id="record">
        <div class="pc-wheels-head">
          <span class="eyebrow muted">System</span>
          <h2>Built to push, view and record</h2>
          <p class="pc-wheels-lead">Control unit · reel · KG41 camera</p>
          <p>
            Capture video and stills with on-screen documentation, export from USB or internal memory, and locate the head with the 512 Hz sonde. Rapido Pro is the complete push-camera system for everyday sewer inspection.
          </p>
        </div>
        <div class="pc-wheels-gallery pc-wheels-gallery--4">
          {
            infographics.map((item) => (
              <figure>
                <img src={item.src} alt={item.alt} loading="lazy" width="1024" height="1024" />
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="block home-stack" id="camera">
    <div class="wrap camera-stack">
      <div class="camera-feature">
        <figure class="camera-feature-visual">
          <img src="/images/rapido-kg41-camera.jpg" alt="KG41 camera head with a focused LED ring around the lens" width="1024" height="1024" />
        </figure>
        <div class="camera-feature-copy">
          <span class="eyebrow muted">Camera head</span>
          <h2>KG41 Full HD</h2>
          <p>The picture comes from the KG41, a stainless head on the end of the rod. It records 1080p. Automatic up-right sensor position keeps the image upright as the head rolls through the pipe. A 105° horizontal view and a focused 4-LED ring light the wall ahead, from 40 mm laterals to 300 mm mains.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">Image</span><span class="v">1080p Full HD</span></div>
            <div class="row"><span class="k">Sensor position</span><span class="v">Automatic up-right</span></div>
            <div class="row"><span class="k">Optics</span><span class="v">105° horizontal field of view</span></div>
            <div class="row"><span class="k">Lighting</span><span class="v">4-LED focused ring</span></div>
            <div class="row"><span class="k">Body</span><span class="v">Stainless steel</span></div>
            <div class="row"><span class="k">In the pipe</span><span class="v">DN40–DN300, skids for DN75 and DN150</span></div>
          </div>
        </div>
      </div>
      <div class="camera-feature camera-feature--bend">
        <div class="camera-feature-copy">
          <span class="eyebrow muted">90° bends</span>
          <h2>Through the elbow</h2>
          <p>A sprung neck sits between the head and the rod. It flexes as the KG41 enters a bend, so the camera follows the pipe instead of stopping at the corner. From DN75, centering skids hold the head on axis through a 90° elbow and the survey continues past it.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">Bends</span><span class="v">90° from DN75</span></div>
            <div class="row"><span class="k">Skids</span><span class="v">DN75 and DN150</span></div>
            <div class="row"><span class="k">Neck</span><span class="v">Sprung, between head and rod</span></div>
          </div>
        </div>
        <figure class="camera-feature-visual">
          <img src="/images/rapido-kg41-spring.jpg" alt="Sprung neck of the KG41 camera head, built to flex through a bend" width="1024" height="1024" />
        </figure>
      </div>
      <div class="camera-feature" id="push-cable">
        <figure class="camera-feature-visual">
          <div class="pd-carousel" data-interval="5000">
            <img class="pd-carousel-slide active" src="/images/rapido-push-cable-reel.jpg" alt="Red push cable coiled on the Rapido reel cart" width="1024" height="1024" />
            <img class="pd-carousel-slide" src="/images/rapido-push-cable-frame.jpg" alt="Rapido reel cart frame without the push cable" width="1024" height="1024" />
          </div>
        </figure>
        <div class="camera-feature-copy">
          <span class="eyebrow muted">Push cable</span>
          <h2>A diameter for each length</h2>
          <p>Rapido 30 uses a 9 mm push cable, Rapido 60 an 11 mm cable and Rapido 90 a 12 mm cable. These diameters are specifically designed to match the geometry of the networks typically inspected with this camera, at each of the corresponding lengths.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">Rapido 30</span><span class="v">9 mm · 30 m</span></div>
            <div class="row"><span class="k">Rapido 60</span><span class="v">11 mm · 60 m</span></div>
            <div class="row"><span class="k">Rapido 90</span><span class="v">12 mm · 90 m</span></div>
          </div>
        </div>
      </div>
      <div class="camera-feature camera-feature--bend" id="power">
        <div class="camera-feature-copy">
          <span class="eyebrow muted">Power</span>
          <h2>Battery operated</h2>
          <p>The system runs from a Milwaukee battery pack mounted on the control unit, so a survey does not need a mains socket at the manhole. The pack clips on and lifts off. When power is available on site, the same control unit also runs from the mains adapter.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">Power</span><span class="v">Milwaukee battery pack</span></div>
            <div class="row"><span class="k">Mount</span><span class="v">On the control unit</span></div>
            <div class="row"><span class="k">Mains</span><span class="v">Adapter, when power is on site</span></div>
          </div>
        </div>
        <figure class="camera-feature-visual camera-feature-visual--photo">
          <img src="/images/rapido-battery.jpg" alt="Milwaukee battery pack mounted on the side of the Rapido control unit" width="1100" height="1100" />
        </figure>
      </div>
      <div class="camera-feature" id="centering">
        <figure class="camera-feature-visual">
          <div class="pd-carousel" data-interval="4000">
            <img class="pd-carousel-slide active" src="/images/rapido-adapter-75.png" alt="75 mm centering adapter for the KG41 camera head" width="1024" height="707" />
            <img class="pd-carousel-slide" src="/images/rapido-adapter-150.png" alt="150 mm centering adapter for the KG41 camera head" width="1024" height="707" />
          </div>
        </figure>
        <div class="camera-feature-copy">
          <span class="eyebrow muted">Centering</span>
          <h2>Adapters for each diameter</h2>
          <p>Two centering adapters hold the camera in the middle of the pipe section. Every system is supplied with a 75 mm adapter and a 150 mm adapter, so the head stays on axis in those diameters.</p>
          <div class="pd-specs">
            <div class="row"><span class="k">75 mm</span><span class="v">Centering adapter</span></div>
            <div class="row"><span class="k">150 mm</span><span class="v">Centering adapter</span></div>
            <div class="row"><span class="k">Supplied</span><span class="v">Both, with the system</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="onsite">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow muted">On site</span>
        <h2>One operator, from the surface</h2>
        <p>The reel cart stays at the manhole. Feed the rod, watch the head on the control screen, and record the survey without a second crew.</p>
      </div>
      <div class="field-gallery">
        {
          fieldPhotos.map((item) => (
            <figure>
              <img class:list={{ 'is-portrait': item.portrait }} src={item.src} alt={item.alt} width="1024" height="768" loading="lazy" />
            </figure>
          ))
        }
      </div>
      <SalesCtas class="sales-ctas--after" />
    </div>
  </section>

  <div class="values">
    <div class="wrap">
      <div class="grid values-grid">
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <h3>DN40–DN300</h3>
          <p>Laterals, house connections and small mains, from 1½″ to 12″. Centering skids keep the head aligned through 90° bends from DN75.</p>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <h3>KG41 Full HD</h3>
          <p>1080p camera head with automatic up-right sensor position, a 105° horizontal field of view and a 4-LED focused ring.</p>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>
          <h3>30, 60 and 90 m reel</h3>
          <p>Red push rod on a steel wheeled cart, with a metre counter and a 512 Hz sonde for locating the head from the surface.</p>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
          <h3>Field control</h3>
          <p>10.1″ 1080p touchscreen, keyboard shortcuts and recording to USB or internal storage. Milwaukee battery pack or mains adapter.</p>
        </div>
      </div>
    </div>
  </div>

</BaseLayout>
