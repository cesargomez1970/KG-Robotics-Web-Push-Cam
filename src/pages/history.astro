---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'History — KG Robotics';
const description =
  'The history of KG Robotics — decades of expertise in sewer inspection, rehabilitation and robotics systems.';
const content = `<section class="block"><div class="wrap">
    <div class="crumbs"><a href="/">Home</a><span class="sep">/</span><span>History</span></div>
    <div class="sec-head"><span class="eyebrow muted">Company</span><h1>History</h1></div>
    <div class="about-body" style="max-width:760px">
      <p>KG Robotics was founded by entrepreneurial engineers with more than 25 years of combined experience in the manufacturing and distribution of equipment and systems for the inspection and maintenance of sewer networks.</p>
      <p>Built on decades of field-proven know-how across leading European manufacturers and distributors, the company set out to make advanced inspection and pipe-rehabilitation technology genuinely accessible — engineered and manufactured in Poland.</p>
    </div>
  </div></section>`;
---
<BaseLayout title={title} description={description} activeFam="about">
  <Fragment set:html={content} />
</BaseLayout>
