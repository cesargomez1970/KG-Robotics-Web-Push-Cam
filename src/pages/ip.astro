---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Intellectual Property — KG Robotics";
const description = "KG Robotics intellectual property and patent-pending LED technology.";
const content = "<section class=\"block\"><div class=\"wrap\">\n    <div class=\"crumbs\"><a href=\"/\">Home</a><span class=\"sep\">/</span><span>Intellectual Property</span></div>\n    <div class=\"sec-head\"><span class=\"eyebrow muted\">Innovation</span><h1>Intellectual Property</h1></div>\n    <div class=\"ip-grid\">\n      <div class=\"about-body\">\n        <p style=\"font-size:18px;color:#3a3d44\">Innovation sits at the core of KG Robotics. Our UV LED curing architecture introduces a new cooling design that increases the efficiency of the UV radiation head while keeping cooling channels fully isolated from the emitting LEDs — guaranteeing a completely sealed head.</p>\n        <p style=\"color:var(--muted)\">This patent-pending technology reduces cooling-air demand by up to 40%, allowing auxiliary equipment to shrink significantly or disappear entirely, and contributes to a lighter, more capable system overall.</p>\n        <p style=\"color:var(--muted)\">We are committed to protecting our developments and respecting the intellectual property of others. Detailed patent and trademark information will be published here as registrations progress.</p>\n      </div>\n      <div><div class=\"ip-badge\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"><path d=\"M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-4z\"/><path d=\"M12 8v5m0 3h.01\"/></svg>\n        <div class=\"pt\">Patent Pending</div><div class=\"ps\">UV LED curing technology</div>\n      </div></div>\n    </div>\n  </div></section>";
---
<BaseLayout title={title} description={description} activeFam="about">
  <Fragment set:html={content} />
</BaseLayout>
