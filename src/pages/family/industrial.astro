---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Industrial / RVI — KG Robotics";
const description = "Visual testing and remote visual inspection for industrial assets.";
const content = "<section class=\"block dark\"><div class=\"wrap\">\n    <div class=\"crumbs\"><a href=\"/\">Home</a><span class=\"sep\">/</span><span>Industrial / RVI</span></div>\n    <div class=\"sec-head\"><span class=\"eyebrow\">Sector</span><h1>Industrial / RVI</h1><p>Visual Testing (VT) and Remote Visual Inspection (RVI) for industrial pipe networks.</p></div>\n    <div class=\"family-intro\">\n      <div class=\"family-img\"><img src=\"/images/img-007.jpg\" alt=\"Industrial / RVI\"/></div>\n      <div class=\"copy\"><p>Across power generation, oil &amp; gas, process and advanced manufacturing, inspection teams face converging pressures — ageing infrastructure, a shortage of skilled labour, tighter inspection intervals and growing regulatory scrutiny.</p><p>KG Robotics inspection equipment provides safe access to confined, hazardous or otherwise unreachable areas, while delivering high-resolution visual data that surfaces early-stage degradation, surface defects and wear mechanisms long before they escalate into failures.</p><p>In this context, Remote Visual Inspection becomes a strategic enabler of asset integrity, operational uptime and predictive maintenance.</p></div>\n    </div>\n    <div class=\"product-grid\"><a class=\"card\" href=\"/product/rapido-pro-atex\"><div class=\"ph\"><img src=\"/images/img-018.jpg\" alt=\"Rapido Pro ATEX\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">Rapido Pro ATEX</div><div class=\"ptag\">Push camera · ATEX-rated</div><p>The Rapido Pro push-camera platform, certified for use in potentially explosive atmospheres — bringing safe visual inspection into hazardous industrial zones.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/product/pipecruiser-hd-100-atex\"><div class=\"ph\"><img src=\"/images/img-019.jpg\" alt=\"PipeCruiser HD 100 ATEX\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">PipeCruiser HD 100 ATEX</div><div class=\"ptag\">Robotic crawler · ATEX-rated</div><p>An ATEX-certified HD crawler for inspecting industrial pipe networks in hazardous environments, combining robotic reach with explosion-protected design.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a></div>\n  </div></section>";
const activeFam = "industrial";
---
<BaseLayout title={title} description={description} activeFam={activeFam}>
  <Fragment set:html={content} />
</BaseLayout>
