---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "LED Curing Systems — KG Robotics";
const description = "Patent-pending LED light-curing systems for trenchless sewer rehabilitation.";
const content = "<section class=\"block\"><div class=\"wrap\">\n    <div class=\"crumbs\"><a href=\"/\">Home</a><span class=\"sep\">/</span><span>LED Curing Systems</span></div>\n    <div class=\"sec-head\"><span class=\"eyebrow muted\">Product Family</span><h1>LED Curing Systems</h1><p>Patent-pending LED light-curing systems for trenchless rehabilitation of sewer networks, from 80 mm.</p></div>\n    <div class=\"family-intro\">\n      <div class=\"family-img\"><img src=\"/images/img-004.jpg\" alt=\"LED Curing Systems\"/></div>\n      <div class=\"copy\"><p>KG Robotics has developed a complete family of LED curing systems for sewer networks, suitable for diameters from as small as 80 mm. Our patent-pending LED technology is integrated into every system and meaningfully improves on the solutions currently available on the market.</p><p>As LED specialists, we have increased the efficiency of the UV radiation head through a new cooling design that also reduces cooling-air demand by up to 40% — allowing auxiliary equipment (compressor, dryer and cooler) to be significantly smaller or, as with the dryer, removed entirely. Cooling runs through independent channels, fully isolated from the UV-emitting LEDs, guaranteeing a completely sealed radiation head.</p><p>Every component has been re-engineered to reduce total system weight — improving operator comfort and expanding the range of sites the system can reach. Because the emitted wavelength is the industry standard, all KG Robotics LED systems are compatible with single-component UV epoxy and VE resins.</p></div>\n    </div>\n    <div class=\"product-grid\"><a class=\"card\" href=\"/product/sewerlight-600\"><div class=\"ph\"><img src=\"/images/img-008.jpg\" alt=\"SewerLight 600\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">SewerLight 600</div><div class=\"ptag\">Laterals & small mainlines</div><p>Compact LED curing system for laterals and small-to-mid diameter mainlines. A lightweight head enables fast deployment and reliable, repeatable cures from 80 mm.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/product/sewerlight-1200\"><div class=\"ph\"><img src=\"/images/img-009.jpg\" alt=\"SewerLight 1200\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">SewerLight 1200</div><div class=\"ptag\">Larger mainlines</div><p>Higher-output LED system for larger mainline diameters, delivering even, controlled radiation across the full length of the liner.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/product/sewerchain-2400\"><div class=\"ph\"><img src=\"/images/img-010.jpg\" alt=\"SewerChain 2400\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">SewerChain 2400</div><div class=\"ptag\">Manholes & large diameters</div><p>Modular LED curing chain engineered for manhole and large-diameter rehabilitation, scaling emitter coverage to the geometry of the structure.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"card\" href=\"/product/nanolight-100\"><div class=\"ph\"><img src=\"/images/img-008.jpg\" alt=\"NanoLight 100\" loading=\"lazy\"/></div><div class=\"card-body\"><div class=\"pname\">NanoLight 100</div><div class=\"ptag\">Tight diameters from 80 mm</div><p>Our most compact curing solution, purpose-built for the tightest diameters and house connections — bringing LED curing where bulkier systems cannot reach.</p><span class=\"card-link\">View product <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a></div>\n  </div></section>";
const activeFam = "led";
---
<BaseLayout title={title} description={description} activeFam={activeFam}>
  <Fragment set:html={content} />
</BaseLayout>
