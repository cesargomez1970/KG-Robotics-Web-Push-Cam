---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Industrial / RVI — KG Robotics';
const description = 'Visual testing and remote visual inspection for industrial assets.';
const activeFam = 'industrial';
---

<BaseLayout title={title} description={description} activeFam={activeFam}>
  <section class="hero hero-family">
    <div class="hero-slides">
      <div class="hero-slide active" style="background-image:url('/images/hero-industrial-2.png')"></div>
      <div class="hero-slide" style="background-image:url('/images/hero-industrial-3.png')"></div>
    </div>
    <div class="hero-overlay"></div>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-family-content">
          <span class="eyebrow">Sector</span>
          <h1>Industrial / RVI</h1>
          <p class="lead">Visual Testing (VT) and Remote Visual Inspection (RVI) for industrial pipe networks.</p>
          <div class="hero-family-copy">
            <p>
              Across power generation, oil &amp; gas, process and advanced manufacturing, inspection teams face converging pressures — ageing infrastructure, a shortage of skilled labour, tighter inspection intervals and growing regulatory scrutiny.
            </p>
            <p>
              KG Robotics inspection equipment provides safe access to confined, hazardous or otherwise unreachable areas, while delivering high-resolution visual data that surfaces early-stage degradation, surface defects and wear mechanisms long before they escalate into failures.
            </p>
            <p>
              In this context, Remote Visual Inspection becomes a strategic enabler of asset integrity, operational uptime and predictive maintenance.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block dark">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="sep">/</span><span>Industrial / RVI</span>
      </div>
      <div class="product-grid">
        <a class="card" href="/product/rapido-pro-atex">
          <div class="ph">
            <img src="/images/img-018.jpg" alt="Rapido Pro ATEX" loading="lazy" />
          </div>
          <div class="card-body">
            <div class="pname">Rapido Pro ATEX</div>
            <div class="ptag">Push camera · ATEX-rated</div>
            <p>
              The Rapido Pro push-camera platform, certified for use in potentially explosive atmospheres — bringing safe visual inspection into hazardous industrial zones.
            </p>
            <span class="card-link"
              >View product <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span
            >
          </div>
        </a>
        <a class="card" href="/product/pipecruiser-hd-100-atex">
          <div class="ph">
            <img src="/images/pipecruiser-100-atex-system-02.png" alt="PipeCruiser 100 HD ATEX" loading="lazy" />
          </div>
          <div class="card-body">
            <div class="pname">PipeCruiser 100 HD ATEX</div>
            <div class="ptag">Industrial inspection robotic crawler · ATEX</div>
            <p>
              A highly portable ATEX HD crawler system for hazardous industrial pipe networks — packed for transport in two rugged cases, with an optional trolley to roll control, reel and crawler as one mobile workstation.
            </p>
            <span class="card-link"
              >View product <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span
            >
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
