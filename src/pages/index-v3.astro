---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackgroundSlides from '../components/HeroBackgroundSlides.astro';

const title = 'KG Robotics — Diagnose & Renovate Sewer Networks';
const description =
  'Equipment for sewer network owners, operators and contractors — UV LED curing, cutting robots, push cameras, crawlers and zoom systems. Engineered in Poland.';

const cippItems = [
  { label: 'UV LED curing', href: '/family/led' },
  { label: 'Cutting Robots', href: '/family/cutting' },
  { label: 'Resins & Liners', soon: true },
];

const inspectItems = [
  { label: 'Push cameras', href: '/product/rapido-pro' },
  { label: 'Robotic Crawlers', href: '/product/pipecruiser-150' },
  { label: 'Zoom Cameras', href: '/product/sewerzoom' },
];
---

<BaseLayout title={title} description={description}>
  <section class="hero hero-v3">
    <HeroBackgroundSlides />
    <div class="hero-overlay"></div>
    <div class="wrap">
      <div class="hero-v3-intro">
        <div class="hero-v3-lead-col hero-v3-anim hero-v3-anim--lead">
          <p class="hero-v3-lead-body">
            At KG ROBOTICS we design &amp; manufacture equipment that supports sewer network owners, operators and contractors in diagnosing and renovating wastewater pipelines. We have redesigned classic technologies — UV LED curing, visual inspection cameras — making them easier to run, harder to break and considerably easier to justify.
          </p>
        </div>

        <div class="hero-v3-divider hero-v3-anim hero-v3-anim--line" aria-hidden="true"></div>

        <div class="hero-v3-sidebar">
          <div class="hero-v3-block">
            <h2 class="hero-v3-heading hero-v3-anim hero-v3-anim--right">CIPP Trenchless</h2>
            <ul class="hero-v3-list">
              {
                cippItems.map((item, i) => (
                  <li class="hero-v3-anim hero-v3-anim--item" style={`--i:${i}`}>
                    {item.soon ? (
                      <span class="hero-v3-soon-item">
                        {item.label}
                        <span class="hero-v3-soon">coming soon</span>
                      </span>
                    ) : (
                      <a href={item.href}>{item.label}</a>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="hero-v3-block hero-v3-inspect">
            <h2 class="hero-v3-heading hero-v3-anim hero-v3-anim--left">Sewer Inspection</h2>
            <ul class="hero-v3-list">
              {
                inspectItems.map((item, i) => (
                  <li class="hero-v3-anim hero-v3-anim--item" style={`--i:${i + 3}`}>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="hero-actions hero-v3-anim hero-v3-anim--actions">
        <a href="/family/led" class="btn btn-accent">
          Explore Products <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="/contact" class="btn btn-ghost">Book a Demo</a>
        <a href="/" class="hero-v3-alt">Home v1</a>
        <a href="/index-v2" class="hero-v3-alt">Home v2</a>
        <a href="/index-v4" class="hero-v3-alt">Home v4</a>
      </div>
    </div>
  </section>

  <div class="values">
    <div class="wrap">
      <div class="grid values-grid">
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2v6m0 0 3-3m-3 3L9 5"/><rect x="4" y="8" width="16" height="13" rx="2"/><path d="M9 13h6M9 17h6"/></svg>
          <h3>UV LED Curing</h3>
          <p>Patent-pending LED systems for trenchless rehabilitation — from laterals at 80 mm to large-diameter mainlines.</p>
          <a href="/product/sewerlight-600" class="value-product">
            <img src="/images/sewerlight-600.png" alt="SewerLight 600" />
            <span class="value-product-label">SewerLight 600</span>
          </a>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/></svg>
          <h3>Cutting Robots</h3>
          <p>Air-powered cutters for milling obstructions and lateral reinstatement during pipe rehabilitation.</p>
          <a href="/product/sewercut-100" class="value-product">
            <img src="/images/img-011.jpg" alt="SewerCut 100" />
            <span class="value-product-label">SewerCut 100</span>
          </a>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <h3>Visual Inspection</h3>
          <p>Push cameras, HD crawlers and zoom systems — field-proven imaging at a fraction of the CAPEX.</p>
          <a href="/product/pipecruiser-250" class="value-product">
            <img src="/images/pipecruiser-250-crawler.png" alt="PipeCruiser 250" />
            <span class="value-product-label">PipeCruiser 250</span>
          </a>
        </div>
        <div class="value">
          <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 17h8M6 11h12M7 7h10"/><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 17v2M17 17v2"/></svg>
          <h3>Van Fitting</h3>
          <p>Turnkey design and supply of CCTV inspection vans — your mobile HQ with KG Robotics systems integrated.</p>
          <a href="/van-fitting" class="value-product">
            <img src="/images/van-fitting-interior.png" alt="Van Fitting" />
            <span class="value-product-label">Van Fitting</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
