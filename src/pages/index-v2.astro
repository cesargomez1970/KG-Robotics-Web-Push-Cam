---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackgroundSlides from '../components/HeroBackgroundSlides.astro';

const title = 'KG Robotics — Inspect · Rehab · Inspect';
const description =
  'Push cameras, robotic crawlers, zoom cameras, UV LED curing and cutting robots for sewer network inspection and trenchless rehabilitation.';

const inspectGroups = [
  {
    title: 'Push Cameras',
    products: [{ name: 'Rapido Pro', href: '/product/rapido-pro' }],
  },
  {
    title: 'Robotic Crawlers',
    products: [
      { name: 'PipeCruiser 150', href: '/product/pipecruiser-150' },
      { name: 'PipeCruiser 250', href: '/product/pipecruiser-250' },
      { name: 'PipeCruiser 800', href: '/product/pipecruiser-800' },
    ],
  },
  {
    title: 'Zoom Cameras',
    products: [{ name: 'SewerZoom', href: '/product/sewerzoom' }],
  },
];

const rehabGroups = [
  {
    title: 'UV LED Curing',
    products: [
      { name: 'SewerLight 600', href: '/product/sewerlight-600' },
      { name: 'SewerLight 1200', href: '/product/sewerlight-1200' },
      { name: 'SewerChain 2400', href: '/product/sewerchain-2400' },
      { name: 'NanoLight 100', href: '/product/nanolight-100' },
    ],
  },
  {
    title: 'Cutters',
    products: [
      { name: 'SewerCut 100', href: '/product/sewercut-100' },
      { name: 'SewerCut 200', href: '/product/sewercut-200' },
    ],
  },
  {
    title: 'Resins & Liners',
    products: [],
    note: 'Range coming soon',
  },
];

const flowColumns = [
  { phase: 'Inspect', groups: inspectGroups },
  { phase: 'Rehab', groups: rehabGroups, accent: true },
  { phase: 'Inspect', groups: inspectGroups },
];
---

<BaseLayout title={title} description={description}>
  <section class="hero hero-v2">
    <HeroBackgroundSlides />
    <div class="hero-overlay"></div>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-v2-main">
          <h1 class="hero-v2-h1">
            <span class="hero-h1-line hero-h1-line--down">
              INSPECT → <span class="o">REHAB</span> → INSPECT
            </span>
          </h1>

          <div class="flow-grid">
            {
              flowColumns.map((col) => (
                <div class={`flow-col${col.accent ? ' flow-col-accent' : ''}`}>
                  <h2 class="flow-phase">{col.phase}</h2>
                  {col.groups.map((group) => (
                    <div class="flow-group">
                      <h3 class="flow-group-title">{group.title}</h3>
                      {group.products.length > 0 ? (
                        <ul class="flow-products">
                          {group.products.map((product) => (
                            <li>
                              <a href={product.href}>{product.name}</a>
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p class="flow-note">{group.note}</p>
                      )}
                    </div>
                  ))}
                </div>
              ))
            }
          </div>

          <p class="lead hero-v2-lead">
            Cure-in-Place-Pipe UV LED curing systems, cutting robots and visual inspection equipment — engineered in Poland to deliver reliable performance at a fraction of the CAPEX.
          </p>
          <div class="hero-actions">
            <a href="/contact" class="btn btn-accent">
              Book a Demo <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="/" class="btn btn-ghost">Home v1</a>
            <a href="/index-v4" class="btn btn-ghost">Home v4</a>
            <a href="/index-v3" class="btn btn-ghost">Home v3</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow muted">Services</span>
        <h2>Van Fitting</h2>
        <p>Turnkey CCTV inspection vans with KG Robotics systems integrated — your mobile HQ on site.</p>
      </div>
      <a href="/van-fitting" class="van-fit-banner">
        <img src="/images/van-fitting-interior.png" alt="Van Fitting" loading="lazy" />
        <span>Explore Van Fitting <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
      </a>
    </div>
  </section>
</BaseLayout>
