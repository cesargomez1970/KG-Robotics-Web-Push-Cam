---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "KG Robotics — Inspection & Rehabilitation Systems for Sewer Networks";
const description = "KG Robotics designs and manufactures LED curing systems, cutting solutions and visual inspection equipment for sewer networks. Made in Poland, engineered for low CAPEX.";
const content = "<section class=\"hero\"><div class=\"hero-slides\"><div class=\"hero-slide active\" style=\"background-image:url('/images/img-001.jpg')\"></div><div class=\"hero-slide\" style=\"background-image:url('/images/img-002.jpg')\"></div><div class=\"hero-slide\" style=\"background-image:url('/images/img-003.jpg')\"></div></div><div class=\"hero-overlay\"></div><div class=\"wrap\"><div class=\"hero-grid\">\n    <div>\n      <span class=\"eyebrow\">Inspection &middot; Rehabilitation &middot; Robotics</span>\n      <h1 data-i18n-html=\"heroH1\">Robust solutions for <span class=\"o\">sewer</span> networks.</h1>\n      <p class=\"lead\">LED curing systems, cutting solutions and visual inspection equipment — engineered in Poland to deliver reliable performance at a fraction of the CAPEX.</p>\n      <div class=\"hero-actions\">\n        <a href=\"/family/led\" class=\"btn btn-accent\">Explore Products <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>\n        <a href=\"/about\" class=\"btn btn-ghost\">About KG Robotics</a>\n      </div>\n    </div>\n  </div></div></section>\n\n  <div class=\"values\"><div class=\"wrap\"><div class=\"grid\">\n    <div class=\"value\"><svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M12 2v6m0 0 3-3m-3 3L9 5\"/><rect x=\"4\" y=\"8\" width=\"16\" height=\"13\" rx=\"2\"/><path d=\"M9 13h6M9 17h6\"/></svg><h3>Lower CAPEX</h3><p>Systems designed to reduce capital requirements, so advanced technology stops being reserved for the largest operators.</p></div>\n    <div class=\"value\"><svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M13 2 4.5 13H11l-1 9 8.5-11H12l1-9z\"/></svg><h3>Engineered Efficiency</h3><p>Re-engineered components and a new cooling architecture cut weight, energy and auxiliary equipment without compromising power.</p></div>\n    <div class=\"value\"><svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"m9 12 2 2 4-4\"/></svg><h3>Field-Proven &amp; Reliable</h3><p>Built around designs validated over decades in the field — robust tools that withstand the harsh reality inside a sewer network.</p></div>\n  </div></div></div>\n\n  <section class=\"block\"><div class=\"wrap\">\n    <div class=\"sec-head\"><span class=\"eyebrow muted\">Product Range</span><h2>Explore our product families</h2><p>Four families covering trenchless rehabilitation, milling, and visual inspection — for sewer networks and industrial assets.</p></div>\n    <div class=\"fam-grid\"><a class=\"fam-card\" href=\"/family/led\"><img src=\"/images/img-004.jpg\" alt=\"LED Curing Systems\"/><div class=\"fc-body\"><h3>LED Curing Systems</h3><p>Patent-pending LED light-curing systems for trenchless rehabilitation of sewer networks, from 80 mm.</p><span class=\"more\">Explore the range <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"fam-card\" href=\"/family/cutting\"><img src=\"/images/img-005.jpg\" alt=\"Cutting Robots\"/><div class=\"fc-body\"><h3>Cutting Robots</h3><p>Robust, air-powered cutters for milling and lateral reinstatement during pipe rehabilitation.</p><span class=\"more\">Explore the range <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"fam-card\" href=\"/family/inspection\"><img src=\"/images/img-006.jpg\" alt=\"Visual Inspection Systems\"/><div class=\"fc-body\"><h3>Visual Inspection Systems</h3><p>Push cameras, robotic crawlers and zoom manhole cameras — field-proven, low-CAPEX inspection.</p><span class=\"more\">Explore the range <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a><a class=\"fam-card\" href=\"/family/industrial\"><img src=\"/images/img-007.jpg\" alt=\"Industrial / RVI\"/><div class=\"fc-body\"><h3>Industrial / RVI</h3><p>Visual Testing (VT) and Remote Visual Inspection (RVI) for industrial pipe networks.</p><span class=\"more\">Explore the range <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></div></a></div>\n  </div></section>";
---
<BaseLayout title={title} description={description}>
  <Fragment set:html={content} />
</BaseLayout>
