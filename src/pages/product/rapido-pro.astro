---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Rapido Pro — KG Robotics';
const description =
  'Rapido Pro+ Full HD push-camera system for sewer inspection from 40 mm to 300 mm — 60 m reel, KG41 camera with auto levelling and portable control unit.';

const systemGallery = [
  { src: '/images/rapido-pro-system-01.png', alt: 'Rapido Pro — push camera reel, control unit and camera head' },
  { src: '/images/rapido-pro-system-02.png', alt: 'Rapido Pro — complete mobile push inspection system' },
  { src: '/images/rapido-pro-system-03.png', alt: 'Rapido Pro — rugged control case and red push rod reel' },
  { src: '/images/rapido-pro-system-04.png', alt: 'Rapido Pro — wheeled reel cart with monitor and keyboard' },
];

const gallery = systemGallery;
---

<BaseLayout title={title} description={description} activeFam="inspection">
  <section class="block">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">Home</a><span class="sep">/</span><a href="/family/inspection">Visual Inspection Systems</a><span class="sep">/</span><span
          >Rapido Pro</span
        >
      </div>
      <div class="pd-grid">
        <div class="pd-img pd-img--carousel">
          <div class="pd-carousel" data-interval="5200">
            {
              systemGallery.map((item, index) => (
                <img
                  class:list={['pd-carousel-slide', { active: index === 0 }]}
                  src={item.src}
                  alt={item.alt}
                  width="1024"
                  height="1024"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              ))
            }
          </div>
        </div>
        <div class="pd-info">
          <span class="eyebrow muted">Visual Inspection Systems</span>
          <h1>Rapido Pro</h1>
          <div class="ptag">Push camera system · Full HD</div>
          <p class="desc">
            Rapido Pro+ Full HD is a push-mode video inspection system for pipelines from approximately <strong>40 mm to 300 mm</strong> — laterals, house
            connections and small mains. A portable control unit, 60&nbsp;m reel and KG41 camera head with automatic axial levelling deliver 1080p imaging,
            on-screen documentation and straightforward field handling from a compact, wheeled platform.
          </p>
          <div class="pd-specs">
            <div class="row">
              <span class="k">CIPP APPLICATION</span><span class="v">Push camera system</span>
            </div>
            <div class="row">
              <span class="k">Inspecting range</span><span class="v">Approx. 40–300 mm (1½″–12″)</span>
            </div>
            <div class="row">
              <span class="k">Camera head</span><span class="v">KG41, 1080p Full HD, auto axial levelling</span>
            </div>
            <div class="row">
              <span class="k">Optics &amp; lighting</span><span class="v">105° horizontal FOV, 4-LED focused ring</span>
            </div>
            <div class="row">
              <span class="k">Push rod &amp; reel</span><span class="v">Ø 11 mm × 60 m, quick-change connectors</span>
            </div>
            <div class="row">
              <span class="k">Reel features</span><span class="v">512 Hz sonde, metre counter, adjustable brake, quick-mount wheels</span>
            </div>
            <div class="row">
              <span class="k">Control unit</span><span class="v">10.1″ 1080p touchscreen, keyboard shortcuts, USB or internal storage</span>
            </div>
            <div class="row">
              <span class="k">Power</span><span class="v">Milwaukee battery pack or mains adapter</span>
            </div>
            <div class="row">
              <span class="k">Pipe bends</span><span class="v">From DN75 at 90° (with centreing skids)</span>
            </div>
            <div class="row">
              <span class="k">HOSE - CABLE</span><span class="v">Up to 60 m flexible umbilical hose</span>
            </div>
            <div class="row">
              <span class="k">WEIGHT</span><span class="v">Lighter than you expect</span>
            </div>
          </div>
          <div class="pd-actions">
            <a href="/contact" class="btn btn-accent">
              Request information <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a href="/family/inspection" class="btn btn-dark">Back to overview</a>
          </div>
        </div>
      </div>

      <div class="pc-wheels">
        <div class="pc-wheels-head">
          <span class="eyebrow muted">System</span>
          <h2>Push inspection, one platform</h2>
          <p class="pc-wheels-lead">Rapido Pro+ Full HD</p>
          <p>
            The reel cart, control console and camera head are designed to work as a single field system: feed the red push rod, track distance on the counter,
            capture video and stills with date, time and project overlays, and export from USB or internal memory. Centreing skids for DN75 and DN150 keep the
            KG41 head aligned in typical lateral sizes; the stainless camera body and steel reel frame are built for daily contractor use.
          </p>
        </div>
        <div class="pc-wheels-gallery pc-wheels-gallery--4">
          {
            gallery.map((item) => (
              <figure>
                <img src={item.src} alt={item.alt} loading="lazy" width="1024" height="1024" />
              </figure>
            ))
          }
        </div>
      </div>

      <div class="pd-more">
        <h3>More in this family</h3>
        <div class="chip-row">
          <a class="chip" href="/product/pipecruiser-150">
            PipeCruiser 150 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/product/pipecruiser-250">
            PipeCruiser 250 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/product/sewerzoom">
            SewerZoom <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="chip" href="/van-fitting">
            Van Fitting <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
