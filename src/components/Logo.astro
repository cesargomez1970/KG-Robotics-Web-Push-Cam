---
interface Props {
  variant?: 'default' | 'light';
}

const { variant = 'default' } = Astro.props;
const src = '/images/logo-v6-regular.png';
---
<a class="brand" href="/" aria-label="KG Robotics — home">
  <img src={src} alt="KG Robotics" class:list={{ 'logo-light': variant === 'light' }} />
</a>
